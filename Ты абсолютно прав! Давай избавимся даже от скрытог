# middlewares.py
from enum import Enum
from typing import Callable, Dict, Any, Awaitable, Optional
from aiogram import BaseMiddleware
from aiogram.types import Update
from tunnel_manager import TunnelManager


class HealthCheckStrategy(Enum):
    """Стратегии проверки здоровья"""
    SIMPLE = "simple"          # Простая проверка is_healthy()
    DETAILED = "detailed"      # Детальная проверка health_check()
    NO_CHECK = "no_check"      # Без проверки (только логирование)
    AUTO_RECONNECT = "auto"    # Автоматическое переподключение


class FlexibleHealthMiddleware(BaseMiddleware):
    """
    Гибкий middleware с поддержкой разных стратегий проверки.
    """
    
    def __init__(
        self, 
        tunnel_manager: TunnelManager,
        strategy: HealthCheckStrategy = HealthCheckStrategy.SIMPLE,
        admin_ids: Optional[list] = None
    ):
        super().__init__()
        self.tunnel_manager = tunnel_manager
        self.strategy = strategy
        self.admin_ids = admin_ids or []
    
    async def _check_simple(self) -> bool:
        """Простая проверка"""
        return await self.tunnel_manager.is_healthy()
    
    async def _check_detailed(self, event: Update) -> bool:
        """Детальная проверка с уведомлением для админов"""
        status = await self.tunnel_manager.health_check()
        
        if not status['all_ok'] and event.message:
            # Для админов показываем детали
            if event.message.from_user.id in self.admin_ids:
                await event.message.answer(
                    f"🔧 *Статус сервисов:*\n"
                    f"SSH: {'✅' if status['ssh'] else '❌'}\n"
                    + "\n".join([f"{name}: {'✅' if ok else '❌'}" 
                                 for name, ok in status['tunnels'].items()]),
                    parse_mode="Markdown"
                )
            else:
                await event.message.answer(
                    "⚠️ Сервис временно недоступен. Попробуйте позже."
                )
        
        return status['all_ok']
    
    async def _check_auto_reconnect(self, event: Update) -> bool:
        """Проверка с автоматическим переподключением"""
        is_healthy = await self.tunnel_manager.is_healthy()
        
        if not is_healthy:
            if event.message and event.message.from_user.id in self.admin_ids:
                await event.message.answer("🔄 Переподключаю туннель...")
            
            try:
                await self.tunnel_manager.reconnect_all()
                await asyncio.sleep(1)
                is_healthy = await self.tunnel_manager.is_healthy()
                
                if is_healthy and event.message:
                    await event.message.answer("✅ Туннель восстановлен!")
            except Exception as e:
                if event.message:
                    await event.message.answer(f"❌ Ошибка восстановления: {e}")
        
        return is_healthy
    
    async def __call__(
        self,
        handler: Callable[[Update, Dict[str, Any]], Awaitable[Any]],
        event: Update,
        data: Dict[str, Any]
    ) -> Any:
        # Выбираем стратегию проверки
        if self.strategy == HealthCheckStrategy.NO_CHECK:
            return await handler(event, data)
        
        elif self.strategy == HealthCheckStrategy.DETAILED:
            is_healthy = await self._check_detailed(event)
        elif self.strategy == HealthCheckStrategy.AUTO_RECONNECT:
            is_healthy = await self._check_auto_reconnect(event)
        else:  # SIMPLE
            is_healthy = await self._check_simple()
        
        if not is_healthy:
            return  # Прерываем обработку
        
        # Передаём менеджер туннеля в хендлер
        data["tunnel_manager"] = self.tunnel_manager
        return await handler(event, data)
