# tunnel_manager.py
import asyncio
import asyncssh
from typing import Optional, Dict, Tuple, Any
from pathlib import Path
import logging

logger = logging.getLogger(__name__)


class TunnelManager:
    """
    Менеджер SSH туннелей для подключения к удалённым сервисам (PostgreSQL, Redis).
    
    Особенности:
    - Создаёт SSH соединение и туннели
    - Автоматически переподключается при обрыве
    - Идемпотентный (можно вызывать connect_ssh много раз)
    - Поддерживает несколько туннелей одновременно
    """
    
    def __init__(
        self,
        ssh_host: str,
        ssh_user: str,
        ssh_key_path: str,
        ssh_port: int = 22,
        local_host: str = "127.0.0.1",
        keepalive_interval: int = 30,
        connect_timeout: int = 10
    ):
        """
        Args:
            ssh_host: Адрес SSH сервера
            ssh_user: Имя пользователя
            ssh_key_path: Путь к приватному ключу
            ssh_port: Порт SSH (по умолчанию 22)
            local_host: Локальный хост для туннелей
            keepalive_interval: Интервал Keepalive в секундах
            connect_timeout: Таймаут подключения в секундах
        """
        self.ssh_host = ssh_host
        self.ssh_user = ssh_user
        self.ssh_port = ssh_port
        self.ssh_key_path = Path(ssh_key_path).expanduser()
        self.local_host = local_host
        self.keepalive_interval = keepalive_interval
        self.connect_timeout = connect_timeout
        
        # SSH соединение
        self._conn: Optional[asyncssh.SSHClientConnection] = None
        self._ssh_lock = asyncio.Lock()
        
        # Туннели
        self._tunnels: list = []
        self._tunnel_configs: Dict[str, Tuple[str, int, str, int]] = {}
        
        # Состояние
        self._is_reconnecting = False
        self._closed = False
        
        logger.info(
            f"TunnelManager инициализирован: {ssh_user}@{ssh_host}:{ssh_port}"
        )
    
    # ==================== SSH СОЕДИНЕНИЕ ====================
    
    async def connect_ssh(self) -> asyncssh.SSHClientConnection:
        """
        Устанавливает SSH соединение.
        Идемпотентный метод — можно вызывать многократно.
        
        Returns:
            asyncssh.SSHClientConnection: Активное SSH соединение
            
        Raises:
            ConnectionError: Если не удалось подключиться
        """
        if self._closed:
            raise RuntimeError("TunnelManager уже закрыт")
        
        async with self._ssh_lock:
            # Проверяем, живое ли соединение
            if self._conn and not self._conn.is_closed():
                try:
                    # Быстрая проверка, что соединение реально работает
                    await self._conn.run('echo "ping"', check=False)
                    return self._conn
                except Exception as e:
                    logger.warning(f"SSH соединение не отвечает: {e}")
                    await self._close_ssh()
            
            # Создаём новое соединение
            logger.info(f"🔌 Подключаюсь к {self.ssh_user}@{self.ssh_host}:{self.ssh_port}...")
            
            try:
                self._conn = await asyncssh.connect(
                    host=self.ssh_host,
                    port=self.ssh_port,
                    username=self.ssh_user,
                    client_keys=[str(self.ssh_key_path)],
                    known_hosts=None,  # Для продакшена укажите known_hosts
                    keepalive_interval=self.keepalive_interval,
                    keepalive_count=3,
                    connect_timeout=self.connect_timeout
                )
                logger.info("✅ SSH соединение установлено")
                return self._conn
                
            except asyncssh.Error as e:
                logger.error(f"❌ Ошибка SSH подключения: {e}")
                self._conn = None
                raise ConnectionError(f"Не удалось подключиться к SSH: {e}") from e
            except Exception as e:
                logger.error(f"❌ Неожиданная ошибка: {e}")
                self._conn = None
                raise
    
    async def _close_ssh(self):
        """Закрывает SSH соединение (внутренний метод)"""
        if self._conn and not self._conn.is_closed():
            try:
                self._conn.close()
                await self._conn.wait_closed()
                logger.debug("SSH соединение закрыто")
            except Exception as e:
                logger.warning(f"Ошибка при закрытии SSH: {e}")
        self._conn = None
    
    # ==================== ТУННЕЛИ ====================
    
    async def create_tunnel(
        self,
        name: str,
        local_port: int,
        remote_host: str,
        remote_port: int,
        local_host: Optional[str] = None
    ) -> asyncssh.SSHListener:
        """
        Создаёт SSH туннель для перенаправления портов.
        
        Args:
            name: Уникальное имя туннеля (например, 'postgres', 'redis')
            local_port: Локальный порт для прослушивания
            remote_host: Удалённый хост (например, 'localhost' или 'db.internal.com')
            remote_port: Удалённый порт (например, 5432 для PostgreSQL)
            local_host: Локальный хост (по умолчанию из __init__)
            
        Returns:
            asyncssh.SSHListener: Объект туннеля
            
        Raises:
            ValueError: Если туннель с таким именем уже существует
        """
        if name in self._tunnel_configs:
            raise ValueError(f"Туннель с именем '{name}' уже существует")
        
        local_host = local_host or self.local_host
        
        # Убеждаемся, что SSH соединение есть
        await self.connect_ssh()
        
        logger.info(
            f"🔗 Создаю туннель '{name}': {local_host}:{local_port} -> {remote_host}:{remote_port}"
        )
        
        try:
            tunnel = await self._conn.forward_local_port(
                local_host, local_port,
                remote_host, remote_port
            )
            
            self._tunnels.append(tunnel)
            self._tunnel_configs[name] = (local_host, local_port, remote_host, remote_port)
            
            logger.info(f"✅ Туннель '{name}' создан")
            return tunnel
            
        except Exception as e:
            logger.error(f"❌ Ошибка создания туннеля '{name}': {e}")
            raise RuntimeError(f"Не удалось создать туннель '{name}': {e}") from e
    
    async def get_tunnel_port(self, name: str) -> int:
        """
        Возвращает локальный порт туннеля по имени.
        
        Args:
            name: Имя туннеля ('postgres' или 'redis')
            
        Returns:
            int: Локальный порт туннеля
        """
        if name not in self._tunnel_configs:
            raise KeyError(f"Туннель '{name}' не найден")
        return self._tunnel_configs[name][1]
    
    async def close_tunnel(self, name: str):
        """
        Закрывает конкретный туннель.
        
        Args:
            name: Имя туннеля для закрытия
        """
        if name not in self._tunnel_configs:
            logger.warning(f"Туннель '{name}' не найден")
            return
        
        # Находим индекс туннеля
        config = self._tunnel_configs[name]
        for i, tunnel in enumerate(self._tunnels):
            # Примерное определение (можно улучшить)
            if i < len(self._tunnels):
                tunnel.close()
                break
        
        del self._tunnel_configs[name]
        logger.info(f"Туннель '{name}' закрыт")
    
    async def close_all_tunnels(self):
        """Закрывает все туннели"""
        for tunnel in self._tunnels:
            try:
                tunnel.close()
            except Exception as e:
                logger.warning(f"Ошибка при закрытии туннеля: {e}")
        self._tunnels.clear()
        self._tunnel_configs.clear()
        logger.debug("Все туннели закрыты")
    
    # ==================== ПЕРЕПОДКЛЮЧЕНИЕ ====================
    
    async def reconnect_all(self):
        """
        Полное пересоздание всех туннелей.
        Используется при обнаружении проблем с соединением.
        """
        if self._is_reconnecting:
            logger.warning("Переподключение уже выполняется, пропускаю")
            return
        
        self._is_reconnecting = True
        logger.warning("🔄 НАЧАЛО ПЕРЕПОДКЛЮЧЕНИЯ ВСЕХ ТУННЕЛЕЙ...")
        
        try:
            # Сохраняем конфигурацию туннелей
            saved_configs = dict(self._tunnel_configs)
            
            # 1. Закрываем старые туннели и SSH
            await self.close_all_tunnels()
            await self._close_ssh()
            
            # 2. Пересоздаём SSH соединение
            await self.connect_ssh()
            
            # 3. Пересоздаём все туннели
            for name, config in saved_configs.items():
                local_host, local_port, remote_host, remote_port = config
                await self.create_tunnel(
                    name=name,
                    local_host=local_host,
                    local_port=local_port,
                    remote_host=remote_host,
                    remote_port=remote_port
                )
            
            logger.info("✅ ВСЕ ТУННЕЛИ УСПЕШНО ПЕРЕСОЗДАНЫ")
            
        except Exception as e:
            logger.error(f"❌ Ошибка при переподключении: {e}")
            raise RuntimeError(f"Не удалось переподключить туннели: {e}") from e
        finally:
            self._is_reconnecting = False
    
    # ==================== HEALTH CHECK ====================
    
    async def health_check(self) -> Dict[str, Any]:
        """
        Проверяет состояние всех сервисов.
        
        Returns:
            dict: {
                'ssh': bool,           # SSH соединение живо
                'tunnels': Dict,       # Статус каждого туннеля
                'all_ok': bool,        # Всё ли работает
                'message': str         # Общее сообщение
            }
        """
        result = {
            'ssh': False,
            'tunnels': {},
            'all_ok': False,
            'message': ''
        }
        
        # 1. Проверяем SSH
        if not self._conn or self._conn.is_closed():
            result['message'] = 'SSH соединение разорвано'
            return result
        
        try:
            # Проверяем, что соединение реально работает
            await self._conn.run('echo "ping"', check=False)
            result['ssh'] = True
        except Exception as e:
            result['message'] = f'SSH не отвечает: {e}'
            return result
        
        # 2. Проверяем туннели (пробуем подключиться к локальным портам)
        all_tunnels_ok = True
        for name, config in self._tunnel_configs.items():
            local_host, local_port, remote_host, remote_port = config
            try:
                # Пытаемся открыть соединение к локальному порту
                reader, writer = await asyncio.open_connection(
                    local_host, local_port,
                    loop=asyncio.get_event_loop()
                )
                writer.close()
                await writer.wait_closed()
                result['tunnels'][name] = True
            except Exception:
                result['tunnels'][name] = False
                all_tunnels_ok = False
                result['message'] = f'Туннель {name} не отвечает'
        
        result['all_ok'] = result['ssh'] and all_tunnels_ok
        if not result['message']:
            result['message'] = 'Все туннели работают'
        
        return result
    
    async def is_healthy(self) -> bool:
        """Быстрая проверка: всё ли работает"""
        status = await self.health_check()
        return status['all_ok']
    
    # ==================== ЗАКРЫТИЕ ====================
    
    async def close(self):
        """Закрывает все соединения (graceful shutdown)"""
        if self._closed:
            return
        
        logger.info("🔒 Закрываю все соединения...")
        self._closed = True
        
        await self.close_all_tunnels()
        await self._close_ssh()
        
        logger.info("✅ Все соединения закрыты")
    
    def __repr__(self) -> str:
        return (
            f"TunnelManager(host={self.ssh_host}, "
            f"user={self.ssh_user}, "
            f"tunnels={list(self._tunnel_configs.keys())})"
        )
