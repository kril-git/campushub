    @staticmethod
    async def create() -> AppDependencies:
        """Создаёт зависимости в зависимости от режима USE_TUNNEL"""
        
        if settings.USE_TUNNEL:
            return await DependenciesFactory._create_with_tunnel()
        else:
            return await DependenciesFactory._create_local()
    
    @staticmethod
    async def _create_with_tunnel() -> AppDependencies:
        """Создаёт зависимости с использованием SSH туннеля"""
        print("🔧 Инициализация с SSH туннелем...")
        
        # 1. Создаём и настраиваем туннель
        tunnel_manager = TunnelManager(
            ssh_host=settings.SSH_HOST,
            ssh_user=settings.SSH_USER,
            ssh_key_path=settings.SSH_KEY_PATH,
            ssh_port=settings.SSH_PORT
        )
        
        # Создаём туннель для PostgreSQL
        await tunnel_manager.create_tunnel(
            name="postgres",
            local_port=settings.POSTGRES_TUNNEL_PORT,
            remote_host=settings.REMOTE_DB_HOST,
            remote_port=settings.REMOTE_DB_PORT
        )
        
        # Если нужен Redis, создаём туннель и для него
        if settings.USE_REDIS:
            await tunnel_manager.create_tunnel(
                name="redis",
                local_port=settings.REDIS_TUNNEL_PORT,
                remote_host=settings.REMOTE_REDIS_HOST,
                remote_port=settings.REMOTE_REDIS_PORT
            )
        
        # 2. Database Helper (через туннель)
        database_url = (
            f"postgresql+asyncpg://{settings.DB_USER}:{settings.DB_PASSWORD}"
            f"@{settings.LOCAL_HOST}:{settings.POSTGRES_TUNNEL_PORT}/{settings.DB_NAME}"
        )
        
        db_helper = DatabaseHelper(
            database_url=database_url,
            echo=settings.DB_ECHO
        )
        await db_helper.init()
        
        # 3. Redis Storage (через туннель)
        redis_port = settings.REDIS_TUNNEL_PORT if settings.USE_REDIS else settings.LOCAL_REDIS_PORT
        redis_client = await Redis.from_url(
            f"redis://{settings.LOCAL_HOST}:{redis_port}",
            decode_responses=True
        )
        
        key_builder = DefaultKeyBuilder(with_bot_id=True, with_destiny=True)
        storage = RedisStorage(
            redis=redis_client,
            key_builder=key_builder,
            state_ttl=60*60*24,
            data_ttl=60*60*48,
        )
        
        print("✅ Туннель создан, зависимости инициализированы")
        
        return AppDependencies(
            tunnel_manager=tunnel_manager,
            db_helper=db_helper,
            redis_client=redis_client,
            storage=storage,
            use_tunnel=True
        )
    
    @staticmethod
    async def _create_local() -> AppDependencies:
        """Создаёт зависимости для локальной работы (без туннеля)"""
        print("🔧 Инициализация в локальном режиме (без туннеля)...")
        
        # 1. Tunnel Manager не нужен
        tunnel_manager = None
        
        # 2. Database Helper (прямое подключение)
        database_url = (
            f"postgresql+asyncpg://{settings.LOCAL_DB_USER}:{settings.LOCAL_DB_PASSWORD}"
            f"@{settings.LOCAL_DB_HOST}:{settings.LOCAL_DB_PORT}/{settings.LOCAL_DB_NAME}"
        )
        
        db_helper = DatabaseHelper(
            database_url=database_url,
            echo=settings.DB_ECHO
        )
        await db_helper.init()
        
        # 3. Redis Storage (локальный)
        redis_client = await Redis.from_url(
            f"redis://{settings.LOCAL_REDIS_HOST}:{settings.LOCAL_REDIS_PORT}",
            decode_responses=True
        )
        
        key_builder = DefaultKeyBuilder(with_bot_id=True, with_destiny=True)
        storage = RedisStorage(
            redis=redis_client,
            key_builder=key_builder,
            state_ttl=60*60*24,
            data_ttl=60*60*48,
        )
        
        print("✅ Локальные зависимости инициализированы")
        
        return AppDependencies(
            tunnel_manager=tunnel_manager,
            db_helper=db_helper,
            redis_client=redis_client,
            storage=storage,
            use_tunnel=False
        )
    
    @staticmethod
    async def close(deps: AppDependencies):
        """Закрывает зависимости (с учётом режима)"""
        print("🔄 Закрытие зависимостей...")
        
        if deps.db_helper:
            await deps.db_helper.close()
        
        if deps.storage:
            await deps.storage.close()
        
        if deps.redis_client:
            await deps.redis_client.close()
        
        # Туннель закрываем только если он был создан
        if deps.tunnel_manager:
            await deps.tunnel_manager.close()
        
        print("✅ Все зависимости закрыты")
