@router.message(Command("reconnect"))
async def cmd_reconnect(message: types.Message, tunnel_manager, use_tunnel: bool):
    """Переподключение туннеля (только если туннель используется)"""
    
    if not use_tunnel:
        await message.answer("ℹ️ Туннель не используется (локальный режим)")
