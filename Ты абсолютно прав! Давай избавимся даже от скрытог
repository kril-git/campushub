# middlewares.py
import asyncio
from typing import Callable, Dict, Any, Awaitable, Optional
from aiogram import BaseMiddleware
from aiogram.types import Update
from tunnel_manager import TunnelManager
from functools import wraps


class AsyncHealthMiddleware(BaseMiddleware):
    """
    Middleware с асинхронной проверкой и кэшированием статуса.
    Не блокирует выполнение, если проверка занимает много времени.
    """
    
    def __init__(self, tunnel_manager: TunnelManager, cache_ttl: int = 5):
        super().__init__()
        self.tunnel_manager = tunnel_manager
        self.cache_ttl = cache_ttl  # секунд
        self._cached_status: Optional[bool] = None
        self._last_check: float = 0
    
    async def _get_cached_status(self) -> bool:
        """Получает статус из кэша или выполняет проверку"""
        import time
        
        now = time.time()
        if self._cached_status is not None and (now - self._last_check) < self.cache_ttl:
            return self._cached_status
        
        # Выполняем проверку с таймаутом
        try:
            async with asyncio.timeout(3):  # таймаут 3 секунды
                self._cached_status = await self.tunnel_manager.is_healthy()
        except asyncio.TimeoutError:
            self._cached_status = False
        except Exception:
            self._cached_status = False
        
        self._last_check = now
        return self._cached_status
    
    async def __call__(
        self,
        handler: Callable[[Update, Dict[str, Any]], Awaitable[Any]],
        event: Update,
        data: Dict[str, Any]
    ) -> Any:
        # Проверяем статус (с кэшированием)
        is_healthy = await self._get_cached_status()
        
        if not is_healthy:
            # Для админских команд можно показать детали
            if event.message and event.message.from_user.id in data.get('admin_ids', []):
                status = await self.tunnel_manager.health_check()
                await event.message.answer(
                    f"🔧 *Техническая информация*\n"
                    f"SSH: {'✅' if status['ssh'] else '❌'}\n"
                    f"Туннели: {status['tunnels']}",
                    parse_mode="Markdown"
                )
            elif event.message:
                await event.message.answer(
                    "⚠️ Сервис временно недоступен. Попробуйте позже."
                )
            return
        
        return await handler(event, data)
