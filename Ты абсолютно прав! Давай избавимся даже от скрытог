    if use_tunnel and tunnel_manager:
        status = await tunnel_manager.health_check()
        tunnel_status = f"\nSSH: {'✅' if status['ssh'] else '❌'}"
    else:
        tunnel_status = "\nSSH: ⏭️ (не используется)"
    
    await message.answer(
        f"{mode_text}\n\n"
        f"✅ Бот работает!\n"
        f"{tunnel_status}\n"
        f"PostgreSQL: {'✅' if db_helper.engine else '❌'}",
        parse_mode="Markdown"
