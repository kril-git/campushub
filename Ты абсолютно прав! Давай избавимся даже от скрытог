# main.py
import asyncio
import logging
from aiogram import Bot, Dispatcher
from aiogram.fsm.strategy import FSMStrategy
from aiogram.fsm.isolation import SimpleEventIsolation

from config import settings
from dependencies import DependenciesFactory
from middlewares import TunnelHealthMiddleware
from handlers import register_handlers


async def main():
    logging.basicConfig(level=logging.INFO)
    
    # 1. Создаём зависимости (автоматически выберет режим)
    deps = await DependenciesFactory.create()
    
    # 2. Создаём бота
    bot = Bot(token=settings.BOT_TOKEN)
    
    # 3. Создаём диспетчера
    dp = Dispatcher(
        storage=deps.storage,
        events_isolation=SimpleEventIsolation(),
        fsm_strategy=FSMStrategy.USER_IN_CHAT
    )
    
    # 4. Передаём зависимости в диспетчер
    dp["deps"] = deps
    dp["db_helper"] = deps.db_helper
    dp["tunnel_manager"] = deps.tunnel_manager
    dp["redis"] = deps.redis_client
    dp["use_tunnel"] = deps.use_tunnel
    
    # 5. Регистрируем middleware (с учётом режима)
    dp.update.middleware(
        TunnelHealthMiddleware(deps.tunnel_manager, deps.use_tunnel)
    )
    
    # 6. Регистрируем хендлеры
    register_handlers(dp)
    
    # 7. Запускаем бота
    mode_text = "через SSH туннель" if deps.use_tunnel else "локально"
    print(f"🚀 Бот запущен в режиме: {mode_text}")
    
    try:
        await dp.start_polling(bot)
    finally:
        await DependenciesFactory.close(deps)
        await bot.session.close()


if __name__ == "__main__":
    asyncio.run(main())
