# handlers.py
from aiogram import Router, types
from aiogram.filters import Command
from aiogram.fsm.context import FSMContext

from dependencies import AppDependencies
from decorators import with_session
from config import settings

router = Router(name="main_router")


@router.message(Command("start"))
async def cmd_start(
    message: types.Message,
    deps: AppDependencies,
    db_helper,
    tunnel_manager,
    use_tunnel: bool
):
    """Показывает режим работы бота и статус сервисов"""
    
    mode_text = "🔌 *Режим: SSH туннель*" if use_tunnel else "💻 *Режим: локальный*"
    
    # Проверка статуса
    if use_tunnel and tunnel_manager:
        status = await tunnel_manager.health_check()
        ssh_status = f"\nSSH: {'✅' if status['ssh'] else '❌'}"
        tunnel_status = "\n".join([f"{name}: {'✅' if ok else '❌'}" 
                                   for name, ok in status['tunnels'].items()])
    else:
        ssh_status = "\nSSH: ⏭️ (не используется)"
        tunnel_status = ""
    
    await message.answer(
        f"{mode_text}\n\n"
        f"✅ Бот работает!\n"
        f"{ssh_status}\n"
        f"{tunnel_status}\n"
        f"PostgreSQL: {'✅' if db_helper.engine else '❌'}\n"
        f"Redis: {'✅' if await deps.redis_client.ping() else '❌'}",
        parse_mode="Markdown"
    )


@router.message(Command("health"))
async def cmd_health(message: types.Message, deps: AppDependencies, use_tunnel: bool):
    """Детальная диагностика"""
    
    if use_tunnel and deps.tunnel_manager:
        status = await deps.tunnel_manager.health_check()
        
        await message.answer(
            f"🏥 *Health Check*\n\n"
            f"SSH: {'✅' if status['ssh'] else '❌'}\n"
            + "\n".join([f"{name}: {'✅' if ok else '❌'}" 
                        for name, ok in status['tunnels'].items()]) +
            f"\n\nСообщение: {status['message']}",
            parse_mode="Markdown"
        )
    else:
        await message.answer(
            "🏥 *Health Check*\n\n"
            "Режим: локальный (без туннеля)\n"
            "PostgreSQL: ✅\n"
            "Redis: ✅",
            parse_mode="Markdown"
        )


@router.message(Command("reconnect"))
async def cmd_reconnect(message: types.Message, deps: AppDependencies, use_tunnel: bool):
    """Переподключение туннеля (только администраторы)"""
    
    if not use_tunnel:
        await message.answer("ℹ️ Туннель не используется (локальный режим)")
        return
    
    if message.from_user.id not in settings.ADMIN_IDS:
        await message.answer("⛔ Доступ запрещён")
        return
    
    await message.answer("🔄 Переподключаю туннель...")
    await deps.tunnel_manager.reconnect_all()
    await message.answer("✅ Туннель переподключён")


@router.message(Command("db_test"))
async def cmd_db_test(message: types.Message, db_helper):
    """Тест работы с БД через декоратор"""
    
    @with_session
    async def test_query(session):
        result = await session.execute("SELECT 1")
        return result.scalar()
    
    try:
        value = await test_query()
        await message.answer(f"✅ БД отвечает: {value}")
    except Exception as e:
        await message.answer(f"❌ Ошибка БД: {e}")


