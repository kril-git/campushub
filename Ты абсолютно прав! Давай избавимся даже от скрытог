# middlewares.py
import asyncio
from typing import Callable, Dict, Any, Awaitable
from aiogram import BaseMiddleware
from aiogram.types import Update
from tunnel_manager import TunnelManager
import logging

logger = logging.getLogger(__name__)


class AutoReconnectMiddleware(BaseMiddleware):
    """
    Middleware с автоматическим переподключением туннеля.
    Если туннель не работает, пробует переподключиться.
    """
    
    def __init__(self, tunnel_manager: TunnelManager, max_retries: int = 2):
        super().__init__()
        self.tunnel_manager = tunnel_manager
        self.max_retries = max_retries
    
    async def __call__(
        self,
        handler: Callable[[Update, Dict[str, Any]], Awaitable[Any]],
        event: Update,
        data: Dict[str, Any]
    ) -> Any:
        for attempt in range(self.max_retries):
            # Проверяем здоровье
            is_healthy = await self.tunnel_manager.is_healthy()
            
            if is_healthy:
                # Всё работает, передаём дальше
                return await handler(event, data)
            
            # Туннель не работает, пробуем переподключиться
            logger.warning(f"Туннель не работает, попытка переподключения {attempt + 1}/{self.max_retries}")
            
            try:
                await self.tunnel_manager.reconnect_all()
                # Даём время на установку соединения
                await asyncio.sleep(1)
            except Exception as e:
                logger.error(f"Ошибка переподключения: {e}")
        
        # Если после всех попыток не удалось
        if event.message:
            await event.message.answer(
                "❌ *Критическая ошибка*\n"
                "Не удалось восстановить подключение к серверу. "
                "Пожалуйста, сообщите администратору.",
                parse_mode="Markdown"
            )
        return  # Прерываем обработку
