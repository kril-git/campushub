# decorators.py
from functools import wraps
from typing import TypeVar, ParamSpec
from sqlalchemy.exc import SQLAlchemyError
import logging

logger = logging.getLogger(__name__)

T = TypeVar('T')
P = ParamSpec('P')


def with_session(method):
    """
    Декоратор для автоматического управления сессией SQLAlchemy.
    Использует глобальный db_helper (устанавливается при инициализации).
    """
    @wraps(method)
    async def wrapper(*args, **kwargs):
        # Импортируем внутри, чтобы избежать циклических импортов
        from dependencies import get_db_helper
        
        db_helper = get_db_helper()
        
        async with db_helper.session_factory() as session:
            try:
                return await method(*args, session=session, **kwargs)
            except SQLAlchemyError as e:
                await session.rollback()
                logger.exception(f"Ошибка БД в {method.__name__}: {e}")
                raise
            except Exception as e:
                await session.rollback()
                logger.exception(f"Ошибка в {method.__name__}: {e}")
                raise
    
    return wrapper
