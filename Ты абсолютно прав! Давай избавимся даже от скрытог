## 📄 6. `middlewares.py` — Middleware

```python
# middlewares.py
from typing import Callable, Dict, Any, Awaitable, Optional
from aiogram import BaseMiddleware
from aiogram.types import Update
from tunnel_manager import TunnelManager
import logging

logger = logging.getLogger(__name__)


class TunnelHealthMiddleware(BaseMiddleware):
    """
    Middleware для проверки здоровья туннеля.
    Если туннель не используется, пропускает проверку.
    """
    
    def __init__(self, tunnel_manager: Optional[TunnelManager], use_tunnel: bool):
        super().__init__()
        self.tunnel_manager = tunnel_manager
        self.use_tunnel = use_tunnel
    
    async def __call__(
        self,
        handler: Callable[[Update, Dict[str, Any]], Awaitable[Any]],
        event: Update,
        data: Dict[str, Any]
    ) -> Any:
        # Если туннель не используется, пропускаем проверку
        if not self.use_tunnel:
            return await handler(event, data)
        
        # Если туннель используется, проверяем его состояние
        if self.tunnel_manager:
            is_healthy = await self.tunnel_manager.is_healthy()
            
            if not is_healthy:
                if event.message:
                    await event.message.answer(
                        "⚠️ *Сервис временно недоступен*\n"
                        "Потеряно подключение к серверу. "
                        "Пожалуйста, попробуйте позже.",
                        parse_mode="Markdown"
                    )
                return
        
        return await handler(event, data)


class DependenciesMiddleware(BaseMiddleware):
    """Middleware для внедрения зависимостей в хендлеры"""
    
    def __init__(self, deps):
        super().__init__()
        self.deps = deps
    
    async def __call__(
        self,
        handler: Callable[[Update, Dict[str, Any]], Awaitable[Any]],
        event: Update,
        data: Dict[str, Any]
    ) -> Any:
        # Внедряем зависимости в каждый хендлер
        data["deps"] = self.deps
        data["db_helper"] = self.deps.db_helper
        data["tunnel_manager"] = self.deps.tunnel_manager
        data["redis"] = self.deps.redis_client
        data["use_tunnel"] = self.deps.use_tunnel
        
        return await handler(event, data)
